# ── Hosted Receipt Bot — operator configuration ────────────────────────
# Set these ONCE on your host (Railway/Render/Fly/Cloud Run env vars, or a
# local .env for testing). Users never see any of this — they just /connect
# and /setkey. NEVER commit the filled-in version.

# From @BotFather on Telegram
TELEGRAM_TOKEN=123456789:AA-your-telegram-bot-token

# Public HTTPS base URL of THIS service (no trailing slash). The OAuth redirect
# becomes  ${BASE_URL}/oauth2callback  — add exactly that to your OAuth client.
BASE_URL=https://yourbot.example.com

# YOUR single Google "Web" OAuth client (you create it once; users never do).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Optional override if your redirect path differs from ${BASE_URL}/oauth2callback
# OAUTH_REDIRECT_URI=https://yourbot.example.com/oauth2callback

# Encryption key for secrets at rest (Google refresh tokens + DeepSeek keys).
# Generate ONCE and keep it safe — losing it means everyone must reconnect:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key
# Optional: separate secret to sign OAuth state. Defaults to FERNET_KEY if unset.
# STATE_SECRET=

# Where the encrypted SQLite datastore lives. In Docker this defaults to
# /app/data/receiptbot.db — mount a persistent volume there.
DB_PATH=data/receiptbot.db

# DeepSeek defaults (each user pastes their OWN key via /setkey).
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Optional: a shared key YOU fund, used for users who haven't run /setkey.
# Leave unset to require each user to bring their own key (offline keyword
# matching still works as a fallback when no key is available).
# SHARED_DEEPSEEK_KEY=sk-...

# Optional allowlist: comma-separated Telegram user IDs. Unset = open to anyone.
# AUTHORIZED_USERS=

# Web server port (most hosts inject this automatically).
PORT=8080

PYTHONUNBUFFERED=1
