# ── Receipt Bot configuration ──────────────────────────────────────────
# Copy this file to /etc/receiptbot.env and fill in your own values.
# NEVER commit the filled-in version — it holds secrets.

# From @BotFather on Telegram
TELEGRAM_TOKEN=123456789:AA-your-telegram-bot-token

# From https://platform.deepseek.com (Account → API Keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# The long ID in your Google Sheet URL: /spreadsheets/d/<THIS>/edit
SHEET_ID=your-google-sheet-id

# The ID in your Google Drive folder URL: /folders/<THIS>
DRIVE_FOLDER_ID=your-drive-folder-id

# OAuth files created during setup (keep these private, never commit)
GOOGLE_CLIENT_SECRET=/home/apple/receiptbot/client_secret.json
GOOGLE_TOKEN_FILE=/home/apple/receiptbot/token.json

# Optional: restrict to specific Telegram user IDs (comma-separated).
# Leave unset = anyone who finds the bot can use it.
# AUTHORIZED_USERS=

PYTHONUNBUFFERED=1
